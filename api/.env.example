# Copy to .env and adjust. .env is gitignored.

# Local development database (docker compose up -d db).
DATABASE_URL="postgresql://pulse:pulse@localhost:5433/pulse?schema=public"

# Signing key for access tokens. Generate your own:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-me-with-a-long-random-string"
JWT_EXPIRES_IN="15m"

# How long a probe may take before it counts as a failure.
PROBE_TIMEOUT_MS=10000

# Consecutive failures before an incident is opened.
FAILURE_THRESHOLD=2

PORT=3000
