// Pulse - uptime monitoring.
//
// Four tables. The first three are what you would expect; `incidents` is the one
// worth explaining: checks record every individual probe, but nobody wants to read
// a stream of 288 daily rows to learn "this has been down since 14:32". An incident
// is opened once a monitor has failed FAILURE_THRESHOLD times in a row and closed
// on the next success, so downtime becomes a period rather than a pile of events.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 takes the connection URL from prisma.config.ts (for the CLI) and from
// the driver adapter passed to PrismaClient (at runtime), not from here.
datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  createdAt    DateTime  @default(now()) @map("created_at")

  monitors     Monitor[]

  @@map("users")
}

model Monitor {
  id             String     @id @default(uuid()) @db.Uuid
  userId         String     @map("user_id") @db.Uuid
  name           String
  url            String
  /// How often to probe, in seconds. Floor enforced in the DTO, not here.
  intervalSec    Int        @default(300) @map("interval_sec")
  /// A monitor is only "up" when it answers with this status.
  expectedStatus Int        @default(200) @map("expected_status")
  /// Give up on a probe after this long.
  timeoutMs      Int        @default(10000) @map("timeout_ms")
  paused         Boolean    @default(false)
  /// Set after each probe so the scheduler can find monitors that are due
  /// without recomputing from the checks table.
  lastCheckedAt  DateTime?  @map("last_checked_at")
  createdAt      DateTime   @default(now()) @map("created_at")

  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  checks         Check[]
  incidents      Incident[]

  // The scheduler's hot query: unpaused monitors ordered by staleness.
  @@index([paused, lastCheckedAt])
  @@index([userId])
  @@map("monitors")
}

model Check {
  id           String   @id @default(uuid()) @db.Uuid
  monitorId    String   @map("monitor_id") @db.Uuid
  /// Null when the request never completed - DNS failure, timeout, refused.
  statusCode   Int?     @map("status_code")
  responseMs   Int?     @map("response_ms")
  ok           Boolean
  /// Populated only on failure, so a red row explains itself.
  error        String?
  checkedAt    DateTime @default(now()) @map("checked_at")

  monitor      Monitor  @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  // Every read of this table is "latest checks for one monitor".
  @@index([monitorId, checkedAt])
  @@map("checks")
}

model Incident {
  id             String    @id @default(uuid()) @db.Uuid
  monitorId      String    @map("monitor_id") @db.Uuid
  startedAt      DateTime  @default(now()) @map("started_at")
  /// Null while the incident is ongoing.
  resolvedAt     DateTime? @map("resolved_at")
  /// Why it went down, taken from the check that opened the incident.
  cause          String?
  failureCount   Int       @default(1) @map("failure_count")

  monitor        Monitor   @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  // Finding a monitor's open incident is the worker's most frequent lookup.
  @@index([monitorId, resolvedAt])
  @@map("incidents")
}
