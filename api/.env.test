# Used by `npm run test:e2e`. Points at the second database created by
# scripts/init-test-db.sql so a test run cannot touch development data.
DATABASE_URL="postgresql://pulse:pulse@localhost:5433/pulse_test?schema=public"
JWT_SECRET="test-secret-not-used-anywhere-real"
JWT_EXPIRES_IN="15m"
PROBE_TIMEOUT_MS=2000
FAILURE_THRESHOLD=2
